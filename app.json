{
  "expo": {
    "name": "VunaPOS",
    "slug": "vunapos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#f8f8f8",
    "icon": "./assets/images/vuna-logo.png",
    "scheme": "vunapos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vuna-logo.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "ke.co.navari.vunapos",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vuna-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f8f8",
          "image": "./assets/images/vuna-logo.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VunaPOS to use your camera to scan item barcodes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
